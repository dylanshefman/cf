# Optional: base URL of the Vercel deployment that hosts the Python serverless APIs.
# Vite does NOT read `.env.example` automatically.
# Copy this file to `.env.local` (recommended) or `.env` for it to take effect.
# If omitted, the app will call same-origin `/api/*`.
VITE_CF_API_BASE_URL=https://cf-phi-three.vercel.app
